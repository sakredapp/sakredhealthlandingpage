{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/sync-blog-content.mjs; vite build && node scripts/prerender-blog.mjs && npx tsx scripts/prerender-pages.ts && npx tsx scripts/prerender-network.ts",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "functions": {
    "api/network/canonical.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap-dynamic.xml",
      "destination": "/api/sitemap-dynamic"
    },
    {
      "source": "/locations/:slug",
      "destination": "/api/network/canonical?kind=location&slug=:slug"
    },
    {
      "source": "/practitioners/:slug",
      "destination": "/api/network/canonical?kind=practitioner&slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    }
  ]
}
