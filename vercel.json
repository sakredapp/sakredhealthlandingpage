{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/sync-blog-content.mjs; vite build && node scripts/prerender-blog.mjs && npx tsx scripts/prerender-pages.ts && npx tsx scripts/prerender-network.ts && node scripts/prerender-home.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "functions": {
    "api/network/canonical.ts": {
      "includeFiles": "dist/spa.html"
    },
    "api/admin/sync-blog-content.ts": {
      "includeFiles": "scripts/blog-content/**"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap-dynamic.xml",
      "destination": "/api/sitemap-dynamic"
    },
    {
      "source": "/locations/:slug",
      "destination": "/api/network/canonical?kind=location&slug=:slug"
    },
    {
      "source": "/practitioners/:slug",
      "destination": "/api/network/canonical?kind=practitioner&slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    }
  ],
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "main": true
    }
  }
}
