# Sakred Health website — environment
#
# Copy to .env for local work; set the real values in Vercel for preview and
# production. Nothing here is read by the browser unless it is prefixed VITE_.

# ─────────────────────────────────────────────────────────────────────
# THE HEALTH NETWORK  (required to light up /discover and provider pages)
# ─────────────────────────────────────────────────────────────────────
# Point these at the SAKRED HEALTH APP's Supabase project — the one that owns
# health_organizations / health_locations / health_practitioners /
# health_modalities / health_location_hours / health_links /
# health_network_submissions.
#
# NOT Sakred Body. NOT the website's own project.
#
# Until these are set, every network surface renders its "the network isn't
# live here" state and the sitemap/prerender skip provider pages.
HEALTH_NETWORK_SUPABASE_URL=

# THE KEYS ARE SPLIT ON PURPOSE. See api/_lib/network-clients.ts.
#
#   ANON          public directory reads. RLS still applies, so a mistake in a
#                 published/seed filter is caught instead of served.
#   SERVICE ROLE  intake and media only. Reachable from exactly two API routes.
#
# The read path REFUSES to start if it finds a service_role JWT in the anon
# slot. The write path has no fallback to the anon key — "not configured" is a
# clearer failure than "permission denied" after someone has filled in a form.
HEALTH_NETWORK_SUPABASE_ANON_KEY=
HEALTH_NETWORK_SUPABASE_SERVICE_ROLE_KEY=

# Deprecated single key. Still honoured for READS ONLY, with a warning, so a
# half-migrated deploy keeps working. Never used for writes.
# HEALTH_NETWORK_SUPABASE_KEY=

# The private bucket the app already owns for application media. Only set this
# if the app named it something else.
# HEALTH_NETWORK_MEDIA_BUCKET=network-application-media

# The column that marks demo/seed provider records. Only change this if the app
# named it something other than `is_seed`.
#
# IMPORTANT: if this column cannot be found, PRODUCTION REFUSES to serve the
# directory rather than risk publishing fictional practitioners. That is
# deliberate — see the seed gate in api/_lib/health-network.ts.
# HEALTH_NETWORK_SEED_COLUMN=is_seed

# Dev-only: include seed records so you can work against demo data.
# Ignored in production; there is no way to enable seeds on the live site.
# HEALTH_NETWORK_ALLOW_SEED=true

# ─────────────────────────────────────────────────────────────────────
# ABUSE PROTECTION  (required for public submissions in production)
# ─────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile. Without TURNSTILE_SECRET_KEY, production REFUSES
# practitioner applications and recommendations rather than running an
# unprotected public write endpoint. Non-production skips the check with a
# warning so local work doesn't need Cloudflare.
#
# Production keys are issued per widget per domain: Cloudflare dashboard →
# Turnstile → Add widget → hostnames sakredhealth.com + www.sakredhealth.com,
# Managed mode. The site key is browser-visible by design; the secret is not.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Cloudflare's official always-passes test pair. LOCAL AND PREVIEW ONLY.
# Deploying these to production would leave the public write endpoints
# effectively unprotected while looking protected, which is worse than having
# no Turnstile at all — the failure is silent.
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Server secret for two things:
#   1. HMAC keys for rate-limit identifiers, so submission_throttle stores an
#      opaque digest rather than a raw IP or email address.
#   2. Signing the 30-minute upload tokens that scope an application photo to
#      the submission it belongs to.
#
# Without it, practitioner PHOTO UPLOADS ARE DISABLED (the form falls back to
# asking for photos by email) and rate-limit digests are unkeyed, which makes
# them brute-forceable. Falls back to SESSION_SECRET if unset.
SUBMISSION_TOKEN_SECRET=

# ─────────────────────────────────────────────────────────────────────
# EXISTING SITE INFRASTRUCTURE
# ─────────────────────────────────────────────────────────────────────
# Postgres for the blog, testimonials, A/B tests and the submission rate-limit
# counters.
#
# The throttle table is a MIGRATION, not a runtime side effect — apply
# migrations/0001_submission_throttle.sql (or `npm run db:push`). If it is
# missing, rate limiting degrades to off and says so in the logs.
DATABASE_URL=

# The website's own Supabase (newsletter/email signups, public image buckets).
# Unrelated to the Health Network — it is no longer used as a fallback for it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin blog CMS session signing.
SESSION_SECRET=

# Bing URL submission (scripts/bing.mjs).
BING_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# MAP  (optional — sensible keyless defaults)
# ─────────────────────────────────────────────────────────────────────
# Defaults to OpenFreeMap: OpenStreetMap data, free, no key. Override to move
# to a paid provider or self-hosted tiles without touching code.
# VITE_MAP_TILES_URL=https://tiles.openfreemap.org/planet
# VITE_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
# A complete style JSON URL, which bypasses the hand-authored Sakred style.
# VITE_MAP_STYLE_URL=
